# Copy to `.env` and adjust if your Docker Postgres settings differ.
# Host port = left side of docker-compose ports (5433:5432 -> localhost:5433).

METADATA_DB_URL=postgresql://postgres:postgres@localhost:5433/machines_db

# Optional: gRPC connect timeout (seconds) for run_connect_check.py
# CONNECT_TIMEOUT_SECONDS=2.0

# Port for agent/run_dra_server.py and seed_dev_machine.py (default 7020)
# DRA_DEV_GRPC_PORT=7020

# OpenAI (optional): prompt-based machine selection (`agent/run_openai_connect.py`)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_CONNECT_RETRIES=4
